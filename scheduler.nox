from clock import Clock
from errors import DuplicateJobError, InvalidJobError, JobNotFoundError, SchedulerStateError
from executor import ExecutionOutcome, InlineExecutor
from job import Job, JobContext
from registry import JobRegistry
from time import MAX_MS, MonotonicInstant, UtcInstant

STATE_CREATED: str = "created"
STATE_RUNNING: str = "running"
STATE_STOPPING: str = "stopping"
STATE_STOPPED: str = "stopped"
STATE_FAILED: str = "failed"

class ScheduledEntry:
    job_id: str
    generation: int
    time_domain: str
    has_next: bool
    next_time_ms: int
    completed: bool

    def __init__(self, job_id: str, generation: int, time_domain: str, has_next: bool, next_time_ms: int) -> None:
        if time_domain != "utc" and time_domain != "monotonic":
            raise InvalidJobError("unknown schedule time domain")
        self.job_id = job_id
        self.generation = generation
        self.time_domain = time_domain
        self.has_next = has_next
        self.next_time_ms = next_time_ms
        self.completed = not has_next

    def set_next(self, has_next: bool, next_time_ms: int) -> None:

        self.has_next = has_next
        self.next_time_ms = next_time_ms
        self.completed = not has_next

class DueItem:
    job_id: str
    generation: int
    time_domain: str
    scheduled_time_ms: int

    def __init__(self, job_id: str, generation: int, time_domain: str, scheduled_time_ms: int) -> None:
        self.job_id = job_id
        self.generation = generation
        self.time_domain = time_domain
        self.scheduled_time_ms = scheduled_time_ms

class TickResult:
    succeeded: int
    failed: int
    skipped: int

    def __init__(self) -> None:
        self.succeeded = 0
        self.failed = 0
        self.skipped = 0

    def dispatched(self) -> int:

        return self.succeeded + self.failed

class Scheduler:
    clock: Clock
    registry: JobRegistry
    executor: InlineExecutor
    schedules: list[ScheduledEntry]
    state_value: str
    generation_counter: int
    has_active_job: bool
    active_job_id: str

    def __init__(self, clock: Clock, max_jobs: int) -> None:
        self.clock = clock
        self.registry = JobRegistry(max_jobs)
        self.executor = InlineExecutor()
        self.schedules = []
        self.state_value = STATE_CREATED
        self.generation_counter = 0
        self.has_active_job = False
        self.active_job_id = ""

    def state(self) -> str:

        return self.state_value

    def start(self) -> None:

        if self.state_value == STATE_RUNNING:
            return
        if self.state_value != STATE_CREATED:
            raise SchedulerStateError(self.state_value, "cannot start")
        self.state_value = STATE_RUNNING

    def stop(self) -> None:

        if self.state_value == STATE_STOPPED or self.state_value == STATE_STOPPING:
            return
        if self.state_value == STATE_CREATED:
            self.state_value = STATE_STOPPED
            return
        if self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "cannot stop")
        if self.has_active_job:
            self.state_value = STATE_STOPPING
        else:
            self.state_value = STATE_STOPPED

    def add(self, target: Job) -> None:

        self._require_mutable()
        if self.has_active_job and self.active_job_id == target.job_id:
            raise DuplicateJobError(target.job_id)
        if self.registry.contains(target.job_id):
            raise DuplicateJobError(target.job_id)
        if self.generation_counter == MAX_MS:
            raise InvalidJobError("scheduler generation limit exceeded")

        time_domain: str = target.time_domain()
        has_next: bool = False
        next_time_ms: int = 0
        if time_domain == "utc":
            next_utc: UtcInstant | None = target.next_utc_at_or_after(self.clock.now_utc())
            has_next = next_utc is not None
            if next_utc is not None:
                next_time_ms = next_utc.epoch_ms
        else:
            next_monotonic: MonotonicInstant | None = target.next_monotonic_at_or_after(self.clock.now_monotonic())
            has_next = next_monotonic is not None
            if next_monotonic is not None:
                next_time_ms = next_monotonic.value_ms
        self.registry.add(target)
        self.generation_counter += 1
        self.schedules.append(ScheduledEntry(target.job_id, self.generation_counter, time_domain, has_next, next_time_ms))

    def remove(self, job_id: str) -> Job:

        self._require_mutable()
        index: int = self._find_schedule(job_id)
        if index < 0:
            raise JobNotFoundError(job_id)
        removed: Job = self.registry.remove(job_id)
        self.schedules.pop(index)
        return removed

    def enable(self, job_id: str) -> None:

        self._require_mutable()
        target: Job = self.registry.get(job_id)
        index: int = self._required_schedule(job_id)
        updated_at: UtcInstant = self.clock.now_utc()
        target.set_enabled(True, updated_at)
        entry: ScheduledEntry = self.schedules[index]
        if entry.time_domain == "utc":
            next_utc: UtcInstant | None = target.next_utc_at_or_after(updated_at)
            self._set_entry_next_utc(entry, next_utc)
        else:
            next_monotonic: MonotonicInstant | None = target.next_monotonic_at_or_after(self.clock.now_monotonic())
            self._set_entry_next_monotonic(entry, next_monotonic)

    def disable(self, job_id: str) -> None:

        self._require_mutable()
        self.registry.disable(job_id, self.clock.now_utc())

    def list_jobs(self) -> list[Job]:

        return self.registry.list_jobs()

    def next_run_utc(self, job_id: str) -> UtcInstant | None:

        index: int = self._required_schedule(job_id)
        entry: ScheduledEntry = self.schedules[index]
        if entry.time_domain != "utc":
            raise InvalidJobError("monotonic schedule has no UTC next run")
        if not entry.has_next:
            return None
        return UtcInstant(entry.next_time_ms)

    def next_run_monotonic(self, job_id: str) -> MonotonicInstant | None:

        index: int = self._required_schedule(job_id)
        entry: ScheduledEntry = self.schedules[index]
        if entry.time_domain != "monotonic":
            raise InvalidJobError("UTC schedule has no monotonic next run")
        if not entry.has_next:
            return None
        return MonotonicInstant(entry.next_time_ms)

    def is_completed(self, job_id: str) -> bool:

        index: int = self._required_schedule(job_id)
        return self.schedules[index].completed

    def tick(self) -> TickResult:

        if self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "tick requires running state")

        now_utc: UtcInstant = self.clock.now_utc()
        now_monotonic: MonotonicInstant = self.clock.now_monotonic()
        due_items: list[DueItem] = self._collect_due(now_utc, now_monotonic)
        result: TickResult = TickResult()

        for due in due_items:
            if self.state_value != STATE_RUNNING:
                break

            schedule_index: int = self._find_schedule(due.job_id)
            if schedule_index < 0:
                result.skipped += 1
                continue
            scheduled: ScheduledEntry = self.schedules[schedule_index]
            if scheduled.generation != due.generation or scheduled.time_domain != due.time_domain or not scheduled.has_next or scheduled.next_time_ms != due.scheduled_time_ms:
                result.skipped += 1
                continue

            selected: Job | None = self.registry.find(due.job_id)
            if selected is None or not selected.enabled:
                result.skipped += 1
                continue

            self.has_active_job = True
            self.active_job_id = due.job_id
            context: JobContext = JobContext(due.job_id, due.time_domain, due.scheduled_time_ms, 1)
            outcome: ExecutionOutcome = self.executor.execute(selected, context)
            self.has_active_job = False
            self.active_job_id = ""

            completed_utc: UtcInstant = self.clock.now_utc()
            completed_monotonic: MonotonicInstant = self.clock.now_monotonic()
            try:
                if outcome.succeeded:
                    selected.record_success(completed_utc)
                    result.succeeded += 1
                else:
                    selected.record_failure(outcome.error_category, completed_utc)
                    result.failed += 1
            except Exception:
                self.state_value = STATE_FAILED
                raise SchedulerStateError(self.state_value, "failed to record execution outcome")

            if self.state_value == STATE_STOPPING:
                self.state_value = STATE_STOPPED
                break

            current_index: int = self._find_schedule(due.job_id)
            current_job: Job | None = self.registry.find(due.job_id)
            if current_index >= 0 and current_job is not None and current_job.enabled:
                current: ScheduledEntry = self.schedules[current_index]
                if current.generation == due.generation:
                    if current.time_domain == "utc":
                        utc_reference_ms: int = due.scheduled_time_ms
                        if completed_utc.epoch_ms > utc_reference_ms:
                            utc_reference_ms = completed_utc.epoch_ms
                        self._set_entry_next_utc(current, current_job.next_utc_after(UtcInstant(utc_reference_ms)))
                    elif current_job.trigger_kind() == "fixed-delay":
                        fixed_delay_next: MonotonicInstant = current_job.next_monotonic_after_completion(completed_monotonic)
                        current.set_next(True, fixed_delay_next.value_ms)
                    else:
                        monotonic_reference_ms: int = due.scheduled_time_ms
                        if completed_monotonic.value_ms > monotonic_reference_ms:
                            monotonic_reference_ms = completed_monotonic.value_ms
                        self._set_entry_next_monotonic(current, current_job.next_monotonic_after(MonotonicInstant(monotonic_reference_ms)))

        return result

    def _collect_due(self, now_utc: UtcInstant, now_monotonic: MonotonicInstant) -> list[DueItem]:

        result: list[DueItem] = []
        for scheduled in self.schedules:
            now_ms: int = now_utc.epoch_ms
            if scheduled.time_domain == "monotonic":
                now_ms = now_monotonic.value_ms
            if scheduled.has_next and scheduled.next_time_ms <= now_ms:
                target: Job | None = self.registry.find(scheduled.job_id)
                if target is not None and target.enabled:
                    candidate: DueItem = DueItem(scheduled.job_id, scheduled.generation, scheduled.time_domain, scheduled.next_time_ms)
                    insertion_index: int = len(result)
                    for i in range(len(result)):
                        existing: DueItem = result[i]
                        earlier_domain: bool = candidate.time_domain == "utc" and existing.time_domain == "monotonic"
                        same_domain: bool = candidate.time_domain == existing.time_domain
                        earlier_time: bool = same_domain and candidate.scheduled_time_ms < existing.scheduled_time_ms
                        same_time_earlier_id: bool = same_domain and candidate.scheduled_time_ms == existing.scheduled_time_ms and candidate.job_id < existing.job_id
                        if earlier_domain or earlier_time or same_time_earlier_id:
                            insertion_index = i
                            break
                    result.insert(insertion_index, candidate)
        return result

    def _find_schedule(self, job_id: str) -> int:

        for i in range(len(self.schedules)):
            if self.schedules[i].job_id == job_id:
                return i
        return -1

    def _set_entry_next_utc(self, entry: ScheduledEntry, next_run: UtcInstant | None) -> None:

        if next_run is None:
            entry.set_next(False, 0)
        else:
            entry.set_next(True, next_run.epoch_ms)

    def _set_entry_next_monotonic(self, entry: ScheduledEntry, next_run: MonotonicInstant | None) -> None:

        if next_run is None:
            entry.set_next(False, 0)
        else:
            entry.set_next(True, next_run.value_ms)

    def _required_schedule(self, job_id: str) -> int:

        index: int = self._find_schedule(job_id)
        if index < 0:
            raise JobNotFoundError(job_id)
        return index

    def _require_mutable(self) -> None:

        if self.state_value != STATE_CREATED and self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "job mutation is not allowed")

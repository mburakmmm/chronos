from clock import Clock
from errors import DuplicateJobError, InvalidJobError, InvalidPolicyError, JobNotFoundError, SchedulerStateError
from events import ChronosEvent, EVENT_CANCELLED, EVENT_COALESCED, EVENT_FAILED, EVENT_MISFIRED, EVENT_OVERLAP_QUEUED, EVENT_OVERLAP_SKIPPED, EVENT_REGISTERED, EVENT_SCHEDULED, EVENT_SCHEDULER_STARTED, EVENT_SCHEDULER_STOPPED, EVENT_SKIPPED, EVENT_STARTED, EVENT_SUCCEEDED, EventDispatcher
from executor import ExecutionOutcome, InlineExecutor
from job import Job, JobContext
from policy import MISFIRE_CATCH_UP, MISFIRE_SKIP, OVERLAP_QUEUE_ONE, RETRY_NONE, JobPolicies
from registry import JobRegistry
from time import Duration, MAX_MS, MonotonicInstant, UtcInstant

STATE_CREATED: str = "created"
STATE_RUNNING: str = "running"
STATE_STOPPING: str = "stopping"
STATE_STOPPED: str = "stopped"
STATE_FAILED: str = "failed"

class ScheduledEntry:
    job_id: str
    generation: int
    time_domain: str
    has_next: bool
    next_time_ms: int
    completed: bool
    running_count: int
    has_pending_overlap: bool
    pending_overlap_time_ms: int
    has_overlap_cursor: bool
    overlap_cursor_time_ms: int

    def __init__(self, job_id: str, generation: int, time_domain: str, has_next: bool, next_time_ms: int) -> None:
        if time_domain != "utc" and time_domain != "monotonic":
            raise InvalidJobError("unknown schedule time domain")
        self.job_id = job_id
        self.generation = generation
        self.time_domain = time_domain
        self.has_next = has_next
        self.next_time_ms = next_time_ms
        self.completed = not has_next
        self.running_count = 0
        self.has_pending_overlap = False
        self.pending_overlap_time_ms = 0
        self.has_overlap_cursor = False
        self.overlap_cursor_time_ms = 0

    def set_next(self, has_next: bool, next_time_ms: int) -> None:

        self.has_next = has_next
        self.next_time_ms = next_time_ms
        self.completed = not has_next

    def queue_overlap(self, scheduled_time_ms: int) -> None:

        self.has_pending_overlap = True
        self.pending_overlap_time_ms = scheduled_time_ms

    def clear_overlap(self) -> None:

        self.has_pending_overlap = False
        self.pending_overlap_time_ms = 0

    def observe_overlap(self, scheduled_time_ms: int) -> None:

        self.has_overlap_cursor = True
        self.overlap_cursor_time_ms = scheduled_time_ms

    def clear_overlap_cursor(self) -> None:

        self.has_overlap_cursor = False
        self.overlap_cursor_time_ms = 0

class DueItem:
    job_id: str
    generation: int
    time_domain: str
    scheduled_time_ms: int
    catch_up: bool
    batch_first: bool
    batch_last: bool
    coalesced_count: int
    coalesced_truncated: bool
    final_has_next: bool
    final_next_time_ms: int

    def __init__(self, job_id: str, generation: int, time_domain: str, scheduled_time_ms: int, catch_up: bool, batch_first: bool, batch_last: bool, coalesced_count: int, coalesced_truncated: bool, final_has_next: bool, final_next_time_ms: int) -> None:
        self.job_id = job_id
        self.generation = generation
        self.time_domain = time_domain
        self.scheduled_time_ms = scheduled_time_ms
        self.catch_up = catch_up
        self.batch_first = batch_first
        self.batch_last = batch_last
        self.coalesced_count = coalesced_count
        self.coalesced_truncated = coalesced_truncated
        self.final_has_next = final_has_next
        self.final_next_time_ms = final_next_time_ms

class TickResult:
    succeeded: int
    failed: int
    skipped: int
    misfired: int
    policy_skipped: int
    catch_up_dispatched: int
    coalesced: int
    coalesced_truncated: int
    overlap_queued: int
    overlap_skipped: int

    def __init__(self) -> None:
        self.succeeded = 0
        self.failed = 0
        self.skipped = 0
        self.misfired = 0
        self.policy_skipped = 0
        self.catch_up_dispatched = 0
        self.coalesced = 0
        self.coalesced_truncated = 0
        self.overlap_queued = 0
        self.overlap_skipped = 0

    def dispatched(self) -> int:

        return self.succeeded + self.failed

class Scheduler:
    clock: Clock
    registry: JobRegistry
    executor: InlineExecutor
    schedules: list[ScheduledEntry]
    state_value: str
    generation_counter: int
    has_active_job: bool
    active_job_id: str
    event_dispatcher: EventDispatcher
    emitting_event: bool

    def __init__(self, clock: Clock, max_jobs: int, max_listeners: int = 16) -> None:
        self.clock = clock
        self.registry = JobRegistry(max_jobs)
        self.executor = InlineExecutor()
        self.schedules = []
        self.state_value = STATE_CREATED
        self.generation_counter = 0
        self.has_active_job = False
        self.active_job_id = ""
        self.event_dispatcher = EventDispatcher(max_listeners)
        self.emitting_event = False

    def state(self) -> str:

        return self.state_value

    def start(self) -> None:

        self._require_not_emitting("cannot start during event delivery")
        if self.state_value == STATE_RUNNING:
            return
        if self.state_value != STATE_CREATED:
            raise SchedulerStateError(self.state_value, "cannot start")
        self.state_value = STATE_RUNNING
        self._emit_scheduler_event(EVENT_SCHEDULER_STARTED)

    def stop(self) -> None:

        self._require_not_emitting("cannot stop during event delivery")
        if self.state_value == STATE_STOPPED or self.state_value == STATE_STOPPING:
            return
        if self.state_value == STATE_CREATED:
            self.state_value = STATE_STOPPED
            self._emit_scheduler_event(EVENT_SCHEDULER_STOPPED)
            return
        if self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "cannot stop")
        if self.has_active_job:
            self.state_value = STATE_STOPPING
        else:
            self.state_value = STATE_STOPPED
            self._emit_scheduler_event(EVENT_SCHEDULER_STOPPED)

    def add_listener(self, listener: (ChronosEvent) -> None) -> None:

        self.event_dispatcher.add_listener(listener)

    def listener_count(self) -> int:

        return self.event_dispatcher.listener_count()

    def listener_failure_count(self) -> int:

        return self.event_dispatcher.listener_failure_count()

    def add(self, target: Job) -> None:

        self._require_mutable()
        if self.has_active_job and self.active_job_id == target.job_id:
            raise DuplicateJobError(target.job_id)
        if self.registry.contains(target.job_id):
            raise DuplicateJobError(target.job_id)
        if self.generation_counter == MAX_MS:
            raise InvalidJobError("scheduler generation limit exceeded")
        self._validate_supported_policies(target)

        time_domain: str = target.time_domain()
        has_next: bool = False
        next_time_ms: int = 0
        if time_domain == "utc":
            next_utc: UtcInstant | None = target.next_utc_at_or_after(self.clock.now_utc())
            has_next = next_utc is not None
            if next_utc is not None:
                next_time_ms = next_utc.epoch_ms
        else:
            next_monotonic: MonotonicInstant | None = target.next_monotonic_at_or_after(self.clock.now_monotonic())
            has_next = next_monotonic is not None
            if next_monotonic is not None:
                next_time_ms = next_monotonic.value_ms
        self.registry.add(target)
        self.generation_counter += 1
        self.schedules.append(ScheduledEntry(target.job_id, self.generation_counter, time_domain, has_next, next_time_ms))
        self._emit_job_event(EVENT_REGISTERED, target.job_id, time_domain, False, 0)
        if has_next:
            self._emit_job_event(EVENT_SCHEDULED, target.job_id, time_domain, True, next_time_ms)

    def remove(self, job_id: str) -> Job:

        self._require_mutable()
        index: int = self._find_schedule(job_id)
        if index < 0:
            raise JobNotFoundError(job_id)
        removed: Job = self.registry.remove(job_id)
        removed_entry: ScheduledEntry = self.schedules[index]
        cancelled_time_ms: int = removed_entry.next_time_ms
        if removed_entry.has_pending_overlap:
            cancelled_time_ms = removed_entry.pending_overlap_time_ms
        self.schedules.pop(index)
        self._emit_job_event(EVENT_CANCELLED, job_id, removed_entry.time_domain, removed_entry.has_next, cancelled_time_ms)
        return removed

    def enable(self, job_id: str) -> None:

        self._require_mutable()
        target: Job = self.registry.get(job_id)
        index: int = self._required_schedule(job_id)
        updated_at: UtcInstant = self.clock.now_utc()
        target.set_enabled(True, updated_at)
        entry: ScheduledEntry = self.schedules[index]
        entry.clear_overlap()
        entry.clear_overlap_cursor()
        if entry.time_domain == "utc":
            next_utc: UtcInstant | None = target.next_utc_at_or_after(updated_at)
            self._set_entry_next_utc(entry, next_utc)
        else:
            next_monotonic: MonotonicInstant | None = target.next_monotonic_at_or_after(self.clock.now_monotonic())
            self._set_entry_next_monotonic(entry, next_monotonic)
        if entry.has_next:
            self._emit_job_event(EVENT_SCHEDULED, target.job_id, entry.time_domain, True, entry.next_time_ms)

    def disable(self, job_id: str) -> None:

        self._require_mutable()
        self.registry.disable(job_id, self.clock.now_utc())

    def list_jobs(self) -> list[Job]:

        return self.registry.list_jobs()

    def next_run_utc(self, job_id: str) -> UtcInstant | None:

        index: int = self._required_schedule(job_id)
        entry: ScheduledEntry = self.schedules[index]
        if entry.time_domain != "utc":
            raise InvalidJobError("monotonic schedule has no UTC next run")
        if not entry.has_next:
            return None
        return UtcInstant(entry.next_time_ms)

    def next_run_monotonic(self, job_id: str) -> MonotonicInstant | None:

        index: int = self._required_schedule(job_id)
        entry: ScheduledEntry = self.schedules[index]
        if entry.time_domain != "monotonic":
            raise InvalidJobError("UTC schedule has no monotonic next run")
        if not entry.has_next:
            return None
        return MonotonicInstant(entry.next_time_ms)

    def is_completed(self, job_id: str) -> bool:

        index: int = self._required_schedule(job_id)
        return self.schedules[index].completed

    def tick(self) -> TickResult:

        self._require_not_emitting("cannot tick during event delivery")
        if self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "tick requires running state")

        now_utc: UtcInstant = self.clock.now_utc()
        now_monotonic: MonotonicInstant = self.clock.now_monotonic()
        due_items: list[DueItem] = self._collect_due(now_utc, now_monotonic)
        result: TickResult = TickResult()
        nested_tick: bool = self.has_active_job

        for due in due_items:
            if self.state_value != STATE_RUNNING:
                break

            schedule_index: int = self._find_schedule(due.job_id)
            if schedule_index < 0:
                result.skipped += 1
                continue
            scheduled: ScheduledEntry = self.schedules[schedule_index]
            if scheduled.generation != due.generation or scheduled.time_domain != due.time_domain or not scheduled.has_next or scheduled.next_time_ms != due.scheduled_time_ms:
                result.skipped += 1
                continue

            if nested_tick and due.job_id != self.active_job_id:
                continue

            selected: Job | None = self.registry.find(due.job_id)
            if selected is None or not selected.enabled:
                result.skipped += 1
                continue

            dispatch_now_ms: int = self.clock.now_utc().epoch_ms
            if due.time_domain == "monotonic":
                dispatch_now_ms = self.clock.now_monotonic().value_ms
            if dispatch_now_ms < due.scheduled_time_ms:
                result.skipped += 1
                continue
            if scheduled.running_count > 0:
                self._handle_active_overlap(scheduled, selected, dispatch_now_ms, result)
                continue
            if due.catch_up:
                if due.batch_first:
                    result.misfired += 1
                    result.coalesced += due.coalesced_count
                    if due.coalesced_truncated:
                        result.coalesced_truncated += 1
                    self._emit_job_event(EVENT_MISFIRED, due.job_id, due.time_domain, True, due.scheduled_time_ms)
                    if due.coalesced_count > 0 or due.coalesced_truncated:
                        self._emit_coalesced_event(due)
            elif dispatch_now_ms > due.scheduled_time_ms:
                policy_config: JobPolicies = selected.policy_config()
                lateness: Duration = Duration(dispatch_now_ms - due.scheduled_time_ms)
                action: str = policy_config.misfire.action_for_lateness(lateness)
                result.misfired += 1
                self._emit_job_event(EVENT_MISFIRED, due.job_id, due.time_domain, True, due.scheduled_time_ms)
                if action == MISFIRE_SKIP:
                    result.skipped += 1
                    result.policy_skipped += 1
                    self._emit_job_event(EVENT_SKIPPED, due.job_id, due.time_domain, True, due.scheduled_time_ms)
                    self._advance_after_skip(scheduled, selected, dispatch_now_ms)
                    if scheduled.has_next:
                        self._emit_job_event(EVENT_SCHEDULED, scheduled.job_id, scheduled.time_domain, True, scheduled.next_time_ms)
                    continue

            if due.catch_up:
                result.catch_up_dispatched += 1
            if scheduled.has_pending_overlap and scheduled.pending_overlap_time_ms == due.scheduled_time_ms:
                scheduled.clear_overlap()
            scheduled.clear_overlap_cursor()
            scheduled.running_count = 1
            self.has_active_job = True
            self.active_job_id = due.job_id
            context: JobContext = JobContext(due.job_id, due.time_domain, due.scheduled_time_ms, 1)
            started_utc: UtcInstant = self.clock.now_utc()
            started_monotonic: MonotonicInstant = self.clock.now_monotonic()
            self._emit_execution_event(EVENT_STARTED, due, started_utc, started_monotonic, started_utc, started_monotonic, "")
            outcome: ExecutionOutcome = self.executor.execute(selected, context)
            scheduled.running_count = 0
            self.has_active_job = False
            self.active_job_id = ""

            completed_utc: UtcInstant = self.clock.now_utc()
            completed_monotonic: MonotonicInstant = self.clock.now_monotonic()
            try:
                if outcome.succeeded:
                    selected.record_success(completed_utc)
                    result.succeeded += 1
                    self._emit_execution_event(EVENT_SUCCEEDED, due, started_utc, started_monotonic, completed_utc, completed_monotonic, "")
                else:
                    selected.record_failure(outcome.error_category, completed_utc)
                    result.failed += 1
                    self._emit_execution_event(EVENT_FAILED, due, started_utc, started_monotonic, completed_utc, completed_monotonic, outcome.error_category)
            except Exception:
                self.state_value = STATE_FAILED
                raise SchedulerStateError(self.state_value, "failed to record execution outcome")

            if self.state_value == STATE_STOPPING:
                self.state_value = STATE_STOPPED
                self._emit_scheduler_event(EVENT_SCHEDULER_STOPPED)
                break

            current_index: int = self._find_schedule(due.job_id)
            current_job: Job | None = self.registry.find(due.job_id)
            if current_index >= 0 and current_job is not None and current_job.enabled:
                current: ScheduledEntry = self.schedules[current_index]
                if current.generation == due.generation:
                    if current.has_pending_overlap:
                        pending_time_ms: int = current.pending_overlap_time_ms
                        current.clear_overlap()
                        current.clear_overlap_cursor()
                        current.set_next(True, pending_time_ms)
                    elif due.catch_up:
                        current.clear_overlap_cursor()
                        if due.batch_last:
                            current.set_next(due.final_has_next, due.final_next_time_ms)
                        elif current.time_domain == "utc":
                            self._set_entry_next_utc(current, current_job.next_utc_after(UtcInstant(due.scheduled_time_ms)))
                        else:
                            self._set_entry_next_monotonic(current, current_job.next_monotonic_after(MonotonicInstant(due.scheduled_time_ms)))
                    elif current.time_domain == "utc":
                        current.clear_overlap_cursor()
                        utc_reference_ms: int = due.scheduled_time_ms
                        if completed_utc.epoch_ms > utc_reference_ms:
                            utc_reference_ms = completed_utc.epoch_ms
                        self._set_entry_next_utc(current, current_job.next_utc_after(UtcInstant(utc_reference_ms)))
                    elif current_job.trigger_kind() == "fixed-delay":
                        current.clear_overlap_cursor()
                        fixed_delay_next: MonotonicInstant = current_job.next_monotonic_after_completion(completed_monotonic)
                        current.set_next(True, fixed_delay_next.value_ms)
                    else:
                        current.clear_overlap_cursor()
                        monotonic_reference_ms: int = due.scheduled_time_ms
                        if completed_monotonic.value_ms > monotonic_reference_ms:
                            monotonic_reference_ms = completed_monotonic.value_ms
                        self._set_entry_next_monotonic(current, current_job.next_monotonic_after(MonotonicInstant(monotonic_reference_ms)))
                    if current.has_next:
                        self._emit_job_event(EVENT_SCHEDULED, current.job_id, current.time_domain, True, current.next_time_ms)

        return result

    def _collect_due(self, now_utc: UtcInstant, now_monotonic: MonotonicInstant) -> list[DueItem]:

        candidates: list[DueItem] = []
        for scheduled in self.schedules:
            now_ms: int = now_utc.epoch_ms
            if scheduled.time_domain == "monotonic":
                now_ms = now_monotonic.value_ms
            if scheduled.has_next and scheduled.next_time_ms <= now_ms:
                target: Job | None = self.registry.find(scheduled.job_id)
                if target is not None and target.enabled:
                    policy_config: JobPolicies = target.policy_config()
                    catch_up_active: bool = False
                    if scheduled.running_count == 0 and scheduled.next_time_ms < now_ms:
                        collection_lateness: Duration = Duration(now_ms - scheduled.next_time_ms)
                        catch_up_active = policy_config.misfire.action_for_lateness(collection_lateness) == MISFIRE_CATCH_UP
                    if catch_up_active:
                        dispatch_times: list[int] = []
                        cursor_ms: int = scheduled.next_time_ms
                        has_cursor: bool = True
                        evaluation_count: int = 0
                        coalesced_count: int = 0
                        while has_cursor and cursor_ms <= now_ms and evaluation_count < policy_config.misfire.max_evaluation_steps:
                            evaluation_count += 1
                            if len(dispatch_times) < policy_config.misfire.max_catch_up_count:
                                dispatch_times.append(cursor_ms)
                            else:
                                coalesced_count += 1
                            if scheduled.time_domain == "utc":
                                next_utc: UtcInstant | None = target.next_utc_after(UtcInstant(cursor_ms))
                                has_cursor = next_utc is not None
                                if next_utc is not None:
                                    cursor_ms = next_utc.epoch_ms
                            else:
                                next_monotonic: MonotonicInstant | None = target.next_monotonic_after(MonotonicInstant(cursor_ms))
                                has_cursor = next_monotonic is not None
                                if next_monotonic is not None:
                                    cursor_ms = next_monotonic.value_ms
                        coalesced_truncated: bool = has_cursor and cursor_ms <= now_ms
                        final_has_next: bool = False
                        final_next_time_ms: int = 0
                        if scheduled.time_domain == "utc":
                            future_utc: UtcInstant | None = target.next_utc_after(now_utc)
                            final_has_next = future_utc is not None
                            if future_utc is not None:
                                final_next_time_ms = future_utc.epoch_ms
                        else:
                            future_monotonic: MonotonicInstant | None = target.next_monotonic_after(now_monotonic)
                            final_has_next = future_monotonic is not None
                            if future_monotonic is not None:
                                final_next_time_ms = future_monotonic.value_ms
                        for i in range(len(dispatch_times)):
                            first: bool = i == 0
                            last: bool = i == len(dispatch_times) - 1
                            item_coalesced_count: int = 0
                            item_coalesced_truncated: bool = False
                            if first:
                                item_coalesced_count = coalesced_count
                                item_coalesced_truncated = coalesced_truncated
                            candidates.append(DueItem(scheduled.job_id, scheduled.generation, scheduled.time_domain, dispatch_times[i], True, first, last, item_coalesced_count, item_coalesced_truncated, final_has_next, final_next_time_ms))
                    else:
                        candidates.append(DueItem(scheduled.job_id, scheduled.generation, scheduled.time_domain, scheduled.next_time_ms, False, False, False, 0, False, False, 0))

        result: list[DueItem] = []
        for candidate in candidates:
            insertion_index: int = len(result)
            for i in range(len(result)):
                existing: DueItem = result[i]
                earlier_domain: bool = candidate.time_domain == "utc" and existing.time_domain == "monotonic"
                same_domain: bool = candidate.time_domain == existing.time_domain
                earlier_time: bool = same_domain and candidate.scheduled_time_ms < existing.scheduled_time_ms
                same_time_earlier_id: bool = same_domain and candidate.scheduled_time_ms == existing.scheduled_time_ms and candidate.job_id < existing.job_id
                if earlier_domain or earlier_time or same_time_earlier_id:
                    insertion_index = i
                    break
            result.insert(insertion_index, candidate)
        return result

    def _find_schedule(self, job_id: str) -> int:

        for i in range(len(self.schedules)):
            if self.schedules[i].job_id == job_id:
                return i
        return -1

    def _set_entry_next_utc(self, entry: ScheduledEntry, next_run: UtcInstant | None) -> None:

        if next_run is None:
            entry.set_next(False, 0)
        else:
            entry.set_next(True, next_run.epoch_ms)

    def _set_entry_next_monotonic(self, entry: ScheduledEntry, next_run: MonotonicInstant | None) -> None:

        if next_run is None:
            entry.set_next(False, 0)
        else:
            entry.set_next(True, next_run.value_ms)

    def _advance_after_skip(self, entry: ScheduledEntry, target: Job, observed_time_ms: int) -> None:

        if entry.time_domain == "utc":
            self._set_entry_next_utc(entry, target.next_utc_after(UtcInstant(observed_time_ms)))
        elif target.trigger_kind() == "fixed-delay":
            next_run: MonotonicInstant = target.next_monotonic_after_completion(MonotonicInstant(observed_time_ms))
            entry.set_next(True, next_run.value_ms)
        else:
            self._set_entry_next_monotonic(entry, target.next_monotonic_after(MonotonicInstant(observed_time_ms)))

    def _validate_supported_policies(self, target: Job) -> None:

        policy_config: JobPolicies = target.policy_config()
        if policy_config.misfire.kind == MISFIRE_CATCH_UP and target.trigger_kind() == "fixed-delay":
            raise InvalidPolicyError("catch-up is not defined for completion-anchored fixed-delay")
        if policy_config.retry.kind != RETRY_NONE:
            raise InvalidPolicyError("retry scheduler integration is not implemented")

    def _handle_active_overlap(self, entry: ScheduledEntry, target: Job, observed_time_ms: int, result: TickResult) -> None:

        policy_config: JobPolicies = target.policy_config()
        reference_ms: int = entry.next_time_ms
        if entry.has_overlap_cursor:
            reference_ms = entry.overlap_cursor_time_ms

        has_candidate: bool = False
        candidate_time_ms: int = 0
        if entry.time_domain == "utc":
            next_utc: UtcInstant | None = target.next_utc_after(UtcInstant(reference_ms))
            has_candidate = next_utc is not None
            if next_utc is not None:
                candidate_time_ms = next_utc.epoch_ms
        elif target.trigger_kind() != "fixed-delay":
            next_monotonic: MonotonicInstant | None = target.next_monotonic_after(MonotonicInstant(reference_ms))
            has_candidate = next_monotonic is not None
            if next_monotonic is not None:
                candidate_time_ms = next_monotonic.value_ms

        if not has_candidate or candidate_time_ms > observed_time_ms:
            return
        entry.observe_overlap(candidate_time_ms)
        if policy_config.overlap.kind == OVERLAP_QUEUE_ONE and not entry.has_pending_overlap:
            entry.queue_overlap(candidate_time_ms)
            result.overlap_queued += 1
            self._emit_job_event(EVENT_OVERLAP_QUEUED, entry.job_id, entry.time_domain, True, candidate_time_ms)
            return

        result.skipped += 1
        result.overlap_skipped += 1
        self._emit_job_event(EVENT_OVERLAP_SKIPPED, entry.job_id, entry.time_domain, True, candidate_time_ms)

    def _required_schedule(self, job_id: str) -> int:

        index: int = self._find_schedule(job_id)
        if index < 0:
            raise JobNotFoundError(job_id)
        return index

    def _require_mutable(self) -> None:

        self._require_not_emitting("job mutation is not allowed during event delivery")
        if self.state_value != STATE_CREATED and self.state_value != STATE_RUNNING:
            raise SchedulerStateError(self.state_value, "job mutation is not allowed")

    def _require_not_emitting(self, message: str) -> None:

        if self.emitting_event:
            raise SchedulerStateError(self.state_value, message)

    def _emit_scheduler_event(self, kind: str) -> None:

        observed_utc: UtcInstant = self.clock.now_utc()
        observed_monotonic: MonotonicInstant = self.clock.now_monotonic()
        occurrence: ChronosEvent = ChronosEvent(kind, "", "none", False, 0, observed_utc.epoch_ms, observed_utc.epoch_ms, observed_monotonic.value_ms, observed_monotonic.value_ms, 0, "", 0, False)
        self._publish(occurrence)

    def _emit_job_event(self, kind: str, job_id: str, time_domain: str, has_scheduled_time: bool, scheduled_time_ms: int) -> None:

        observed_utc: UtcInstant = self.clock.now_utc()
        observed_monotonic: MonotonicInstant = self.clock.now_monotonic()
        occurrence: ChronosEvent = ChronosEvent(kind, job_id, time_domain, has_scheduled_time, scheduled_time_ms, observed_utc.epoch_ms, observed_utc.epoch_ms, observed_monotonic.value_ms, observed_monotonic.value_ms, 0, "", 0, False)
        self._publish(occurrence)

    def _emit_coalesced_event(self, due: DueItem) -> None:

        observed_utc: UtcInstant = self.clock.now_utc()
        observed_monotonic: MonotonicInstant = self.clock.now_monotonic()
        occurrence: ChronosEvent = ChronosEvent(EVENT_COALESCED, due.job_id, due.time_domain, True, due.scheduled_time_ms, observed_utc.epoch_ms, observed_utc.epoch_ms, observed_monotonic.value_ms, observed_monotonic.value_ms, 0, "", due.coalesced_count, due.coalesced_truncated)
        self._publish(occurrence)

    def _emit_execution_event(self, kind: str, due: DueItem, started_utc: UtcInstant, started_monotonic: MonotonicInstant, completed_utc: UtcInstant, completed_monotonic: MonotonicInstant, error_category: str) -> None:

        occurrence: ChronosEvent = ChronosEvent(kind, due.job_id, due.time_domain, True, due.scheduled_time_ms, started_utc.epoch_ms, completed_utc.epoch_ms, started_monotonic.value_ms, completed_monotonic.value_ms, 1, error_category, 0, False)
        self._publish(occurrence)

    def _publish(self, occurrence: ChronosEvent) -> None:

        self.emitting_event = True
        try:
            self.event_dispatcher.emit(occurrence)
        finally:
            self.emitting_event = False

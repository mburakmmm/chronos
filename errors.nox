class ChronosError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidDurationError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class TimeRangeError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidTriggerError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class CronParseError(ChronosError):
    field_name: str
    token: str

    def __init__(self, field_name: str, token: str, message: str) -> None:
        super().__init__("cron " + field_name + " token '" + token + "': " + message)
        self.field_name = field_name
        self.token = token

class CronSearchLimitError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidJobError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class DuplicateJobError(ChronosError):
    job_id: str

    def __init__(self, job_id: str) -> None:
        super().__init__("job '" + job_id + "' is already registered")
        self.job_id = job_id

class JobNotFoundError(ChronosError):
    job_id: str

    def __init__(self, job_id: str) -> None:
        super().__init__("job '" + job_id + "' is not registered")
        self.job_id = job_id

class SchedulerStateError(ChronosError):
    state: str

    def __init__(self, state: str, message: str) -> None:
        super().__init__("scheduler state '" + state + "': " + message)
        self.state = state

class InvalidEventError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class EventListenerLimitError(ChronosError):
    limit: int

    def __init__(self, limit: int) -> None:
        super().__init__("event listener limit reached")
        self.limit = limit

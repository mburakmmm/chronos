class ChronosError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidDurationError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class TimeRangeError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidTriggerError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class CronParseError(ChronosError):
    field_name: str
    token: str

    def __init__(self, field_name: str, token: str, message: str) -> None:
        super().__init__("cron " + field_name + ": " + message)
        self.field_name = field_name
        self.token = token

class CronSearchLimitError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidJobError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class DuplicateJobError(ChronosError):
    job_id: str

    def __init__(self, job_id: str) -> None:
        super().__init__("job '" + job_id + "' is already registered")
        self.job_id = job_id

class JobNotFoundError(ChronosError):
    job_id: str

    def __init__(self, job_id: str) -> None:
        super().__init__("job '" + job_id + "' is not registered")
        self.job_id = job_id

class SchedulerStateError(ChronosError):
    state: str

    def __init__(self, state: str, message: str) -> None:
        super().__init__("scheduler state '" + state + "': " + message)
        self.state = state

class InvalidEventError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class EventListenerLimitError(ChronosError):
    limit: int

    def __init__(self, limit: int) -> None:
        super().__init__("event listener limit reached")
        self.limit = limit

class InvalidPolicyError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class StoreError(ChronosError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class InvalidStoredJobError(StoreError):
    def __init__(self, message: str) -> None:
        super().__init__(message)

class StoreConflictError(StoreError):
    job_id: str
    expected_revision: int
    actual_revision: int

    def __init__(self, job_id: str, expected_revision: int, actual_revision: int) -> None:
        super().__init__("stored job revision conflict")
        self.job_id = job_id
        self.expected_revision = expected_revision
        self.actual_revision = actual_revision

class StoreCorruptionError(StoreError):
    category: str

    def __init__(self, category: str) -> None:
        super().__init__("stored data is corrupted")
        self.category = category

class UnsupportedStoreVersionError(StoreError):
    component: str
    found_version: int
    supported_version: int

    def __init__(self, component: str, found_version: int, supported_version: int) -> None:
        super().__init__("unsupported stored format version")
        self.component = component
        self.found_version = found_version
        self.supported_version = supported_version

class UnknownHandlerError(StoreError):
    handler_key: str

    def __init__(self, handler_key: str) -> None:
        super().__init__("stored handler key is not registered")
        self.handler_key = handler_key

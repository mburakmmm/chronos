from nox.http import HttpResponse
from aether.application import Application
from aether.context import HttpContext
from aether.interceptor import make_interceptor
from aether.module import ModuleBuilder
from chronos.clock import Clock
from chronos.scheduler import Scheduler
from chronos.system_clock import SystemClock

def build_scheduler() -> Scheduler:
    source_clock: Clock = SystemClock()
    engine: Scheduler = Scheduler(source_clock, 128)
    engine.start()
    return engine

def install_request_polling(application: Application, engine: Scheduler) -> None:
    def poll_before_request(context: HttpContext) -> HttpResponse | None:
        engine.tick()
        return None

    def preserve_response(context: HttpContext, response: HttpResponse) -> HttpResponse:
        return response

    def stop_scheduler() -> None:
        engine.stop()

    module_builder: ModuleBuilder = application.module()
    module_builder.use_interceptor(make_interceptor(poll_before_request, preserve_response))
    application.on_shutdown(stop_scheduler)

print("chronos aether integration ready")

from errors import TimeRangeError
from time import Duration, MAX_MS, MonotonicInstant, UtcInstant, add_monotonic_duration, elapsed_between, multiply_duration, require_positive_interval

protocol UtcTrigger:
    def next_fire_after(self, reference: UtcInstant) -> UtcInstant | None:
        pass

    def next_fire_at_or_after(self, reference: UtcInstant) -> UtcInstant | None:

        pass

protocol MonotonicTrigger:
    def next_fire_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:
        pass

    def next_fire_at_or_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:

        pass

class OnceTrigger:
    target: UtcInstant

    def __init__(self, target: UtcInstant) -> None:
        self.target = target

    def next_fire_after(self, reference: UtcInstant) -> UtcInstant | None:

        if self.target.epoch_ms > reference.epoch_ms:
            return self.target
        return None

    def next_fire_at_or_after(self, reference: UtcInstant) -> UtcInstant | None:

        if self.target.epoch_ms >= reference.epoch_ms:
            return self.target
        return None

class DelayTrigger:
    deadline: MonotonicInstant

    def __init__(self, registered_at: MonotonicInstant, delay: Duration) -> None:
        self.deadline = add_monotonic_duration(registered_at, delay)

    def next_fire_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:

        if self.deadline.value_ms > reference.value_ms:
            return self.deadline
        return None

    def next_fire_at_or_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:

        if self.deadline.value_ms >= reference.value_ms:
            return self.deadline
        return None

class FixedRateTrigger:
    anchor: MonotonicInstant
    interval: Duration

    def __init__(self, anchor: MonotonicInstant, interval: Duration) -> None:
        self.anchor = anchor
        self.interval = require_positive_interval(interval)

    def next_fire_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:

        if reference.value_ms < self.anchor.value_ms:
            return self.anchor

        elapsed: Duration = elapsed_between(self.anchor, reference)
        completed_intervals: int = elapsed.value_ms // self.interval.value_ms
        if completed_intervals == MAX_MS:
            raise TimeRangeError("fixed-rate occurrence index overflow")
        next_index: int = completed_intervals + 1
        offset: Duration = multiply_duration(self.interval, next_index)
        return add_monotonic_duration(self.anchor, offset)

    def next_fire_at_or_after(self, reference: MonotonicInstant) -> MonotonicInstant | None:

        if reference.value_ms <= self.anchor.value_ms:
            return self.anchor

        elapsed: Duration = elapsed_between(self.anchor, reference)
        occurrence_index: int = elapsed.value_ms // self.interval.value_ms
        if elapsed.value_ms % self.interval.value_ms != 0:
            if occurrence_index == MAX_MS:
                raise TimeRangeError("fixed-rate occurrence index overflow")
            occurrence_index += 1
        offset: Duration = multiply_duration(self.interval, occurrence_index)
        return add_monotonic_duration(self.anchor, offset)

class FixedDelay:
    delay: Duration

    def __init__(self, delay: Duration) -> None:
        self.delay = require_positive_interval(delay)

    def next_after_completion(self, completed_at: MonotonicInstant) -> MonotonicInstant:

        return add_monotonic_duration(completed_at, self.delay)

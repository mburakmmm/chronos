import nox.strings
import nox.test
from chronos.errors import InvalidStoredJobError, StoreConflictError, StoreError, UnknownHandlerError, UnsupportedStoreVersionError
from chronos.handler_registry import HandlerRegistry
from chronos.job import Job, JobContext
from chronos.job_codec import encode_cron_utc, encode_once_utc, encode_policies, restore_utc_job
from chronos.policy import JobPolicies, catch_up_misfires, default_job_policies, exponential_retry, fire_once_misfires, forbid_overlap, no_retry, queue_one_overlap
from chronos.store import JOB_DEFINITION_FORMAT_VERSION, HANDLER_CONFIG_FORMAT_VERSION, POLICY_FORMAT_VERSION, TRIGGER_FORMAT_VERSION, JobStore, StoredJobDefinition, copy_stored_job_definition, make_stored_job_definition
from chronos.time import Duration, MAX_MS, UtcInstant

class MemoryBackend:
    definitions: list[StoredJobDefinition]

    def __init__(self) -> None:
        self.definitions = []
        self.closed = False

    def load(self, job_id: str) -> StoredJobDefinition | None:

        for definition in self.definitions:
            if definition.job_id == job_id:
                return copy_stored_job_definition(definition)
        return None

    def load_all(self) -> list[StoredJobDefinition]:

        result: list[StoredJobDefinition] = []
        for definition in self.definitions:
            result.append(copy_stored_job_definition(definition))
        return result

    def put(self, definition: StoredJobDefinition, expected_revision: int) -> None:

        found_index: int = -1
        for i in range(len(self.definitions)):
            if self.definitions[i].job_id == definition.job_id:
                found_index = i
        if expected_revision == 0:
            if found_index >= 0 or definition.revision != 1:
                actual: int = 0
                if found_index >= 0:
                    actual = self.definitions[found_index].revision
                raise StoreConflictError(definition.job_id, expected_revision, actual)
            self.definitions.append(copy_stored_job_definition(definition))
            return
        if found_index < 0:
            raise StoreConflictError(definition.job_id, expected_revision, 0)
        actual_revision: int = self.definitions[found_index].revision
        if actual_revision != expected_revision or definition.revision != expected_revision + 1:
            raise StoreConflictError(definition.job_id, expected_revision, actual_revision)
        self.definitions[found_index] = copy_stored_job_definition(definition)

    def delete(self, job_id: str, expected_revision: int) -> None:

        for i in range(len(self.definitions)):
            if self.definitions[i].job_id == job_id:
                if self.definitions[i].revision != expected_revision:
                    raise StoreConflictError(job_id, expected_revision, self.definitions[i].revision)
                self.definitions.pop(i)
                return
        raise StoreConflictError(job_id, expected_revision, 0)

    def close(self) -> None:

        self.closed = True

def definition(revision: int, updated_at_ms: int) -> StoredJobDefinition:
    return make_stored_job_definition("billing.daily", "Daily billing", "billing-handler", "{\"account\":\"public\"}", "once-utc", "{\"target_utc_ms\":2000}", "{\"misfire\":\"fire-once\"}", True, UtcInstant(1000), UtcInstant(updated_at_ms), revision)

def rejects_invalid_handler_key() -> bool:
    try:
        make_stored_job_definition("billing.daily", "Daily billing", "bad handler", "", "once-utc", "target=2000", "default", True, UtcInstant(1000), UtcInstant(1000), 1)
    except InvalidStoredJobError:
        return True
    return False

def rejects_oversized_config() -> bool:
    try:
        make_stored_job_definition("billing.daily", "Daily billing", "billing-handler", "", "once-utc", nox.strings.repeat("x", 16385), "default", True, UtcInstant(1000), UtcInstant(1000), 1)
    except InvalidStoredJobError:
        return True
    return False

def rejects_nul_config() -> bool:
    try:
        make_stored_job_definition("billing.daily", "Daily billing", "billing-handler", "bad\x00config", "once-utc", "target=2000", "default", True, UtcInstant(1000), UtcInstant(1000), 1)
    except InvalidStoredJobError:
        return True
    return False

def rejects_unknown_trigger_version() -> bool:
    try:
        StoredJobDefinition("billing.daily", "Daily billing", "billing-handler", "", "once-utc", "target=2000", "default", True, 1000, 1000, 1, JOB_DEFINITION_FORMAT_VERSION, HANDLER_CONFIG_FORMAT_VERSION, TRIGGER_FORMAT_VERSION + 1, POLICY_FORMAT_VERSION)
    except UnsupportedStoreVersionError as error:
        return error.component == "trigger" and error.found_version == 2 and error.supported_version == 1
    return False

def detects_revision_conflict(backend: MemoryBackend) -> bool:
    try:
        backend.put(definition(3, 1200), 1)
    except StoreConflictError as error:
        return error.job_id == "billing.daily" and error.expected_revision == 1 and error.actual_revision == 2
    return False

concrete: MemoryBackend = MemoryBackend()
view: JobStore = concrete
view.put(definition(1, 1000), 0)
loaded: StoredJobDefinition | None = view.load("billing.daily")
nox.test.assert_true(loaded is not None, "store protocol loads created definition")
if loaded is not None:
    nox.test.assert_eq_str(loaded.handler_key, "billing-handler", "store definition retains handler key rather than callback")
    nox.test.assert_eq_str(loaded.trigger_kind, "once-utc", "store definition retains trigger kind")
    loaded.name = "mutated"
nox.test.assert_eq_str(view.load_all()[0].name, "Daily billing", "store boundary returns defensive definitions")

view.put(definition(2, 1100), 1)
nox.test.assert_eq_int(view.load_all()[0].revision, 2, "compare-and-swap update advances revision")
nox.test.assert_true(detects_revision_conflict(concrete), "stale revision is rejected")
nox.test.assert_true(rejects_invalid_handler_key(), "handler key uses bounded identifier syntax")
nox.test.assert_true(rejects_oversized_config(), "serialized configuration is bounded")
nox.test.assert_true(rejects_nul_config(), "serialized configuration rejects embedded NUL")
nox.test.assert_true(rejects_unknown_trigger_version(), "unknown trigger format version is explicit")

view.delete("billing.daily", 2)
nox.test.assert_eq_int(len(view.load_all()), 0, "revision-checked delete removes definition")
view.close()
nox.test.assert_true(concrete.closed, "store protocol has explicit lifecycle")

class HandlerObservation:
    calls: int
    last: str

    def __init__(self) -> None:
        self.calls = 0
        self.last = ""

def record_handler(observed: HandlerObservation) -> (JobContext, str) -> None:
    def record(context: JobContext, config: str) -> None:
        observed.calls += 1
        observed.last = context.job_id + ":" + config

    return record

def rejects_duplicate_handler(handlers: HandlerRegistry, callback: (JobContext, str) -> None) -> bool:
    try:
        handlers.register("billing-handler", callback)
    except StoreError as error:
        return error.message == "handler key is already registered"
    return False

def rejects_bad_registration(handlers: HandlerRegistry, callback: (JobContext, str) -> None) -> bool:
    try:
        handlers.register("bad key", callback)
    except InvalidStoredJobError:
        return True
    return False

def rejects_unknown_handler(handlers: HandlerRegistry, saved: StoredJobDefinition) -> bool:
    try:
        handlers.bind(saved)
    except UnknownHandlerError as error:
        return error.handler_key == "billing-handler" and error.message == "stored handler key is not registered"
    return False

def rejects_mutated_definition(handlers: HandlerRegistry, saved: StoredJobDefinition) -> bool:
    try:
        handlers.bind(saved)
    except InvalidStoredJobError:
        return True
    return False

def rejects_excess_handler(handlers: HandlerRegistry, callback: (JobContext, str) -> None) -> bool:
    try:
        handlers.register("excess", callback)
    except StoreError as error:
        return error.message == "handler registry capacity reached"
    return False

observed: HandlerObservation = HandlerObservation()
other_observed: HandlerObservation = HandlerObservation()
handlers: HandlerRegistry = HandlerRegistry()
callback: (JobContext, str) -> None = record_handler(observed)
saved: StoredJobDefinition = definition(1, 1000)
handlers.register("billing-handler", callback)
nox.test.assert_true(rejects_duplicate_handler(handlers, record_handler(other_observed)), "duplicate handler registration must preserve the original")
nox.test.assert_true(rejects_bad_registration(handlers, callback), "registry shares the stored handler key rules")
nox.test.assert_true(rejects_unknown_handler(HandlerRegistry(), saved), "registry ownership is isolated and unknown keys fail closed")
bound: (JobContext) -> None = handlers.bind(saved)
nox.test.assert_eq_int(observed.calls, 0, "binding never invokes the callback")
saved.handler_config = "subsequent change"
bound(JobContext("billing.daily", "utc", 2000, 1))
nox.test.assert_eq_str(observed.last, "billing.daily:{\"account\":\"public\"}", "bound callback retains original config and receives the live context")
nox.test.assert_eq_int(other_observed.calls, 0, "duplicate registration did not replace the callback")
saved.handler_config = "bad\x00config"
nox.test.assert_true(rejects_mutated_definition(handlers, saved), "binding revalidates mutable stored data")
for index in range(1023):
    handlers.register("extra:" + str(index), callback)
nox.test.assert_true(rejects_excess_handler(handlers, callback), "registry caps distinct handler keys")

def codec_definition(kind: str, trigger_config: str, policy_config: str) -> StoredJobDefinition:
    return make_stored_job_definition("billing.daily", "Daily billing", "billing-handler", "public", kind, trigger_config, policy_config, False, UtcInstant(1000), UtcInstant(1100), 2)

def rejects_codec_record(value: StoredJobDefinition, handlers: HandlerRegistry, message: str) -> bool:
    try:
        restore_utc_job(value, handlers)
    except InvalidStoredJobError as error:
        return error.message == message
    return False

defaults_encoded: str = encode_policies(default_job_policies())
once_record: StoredJobDefinition = codec_definition("once-utc", encode_once_utc(UtcInstant(MAX_MS)), defaults_encoded)
once_job: Job = restore_utc_job(once_record, handlers)
once_next: UtcInstant | None = once_job.next_utc_at_or_after(UtcInstant(MAX_MS))
nox.test.assert_true(once_next is not None, "int64 maximum survives the once codec")
if once_next is not None:
    nox.test.assert_eq_int(once_next.epoch_ms, MAX_MS, "once timestamp remains exact")
nox.test.assert_eq_int(once_job.policy_config().misfire.grace_period_ms, MAX_MS, "maximum policy grace remains exact")
nox.test.assert_true(not once_job.enabled, "restoration preserves the disabled state")
nox.test.assert_eq_int(once_job.updated_at_utc_ms, 1100, "restoration preserves update time")
nox.test.assert_eq_int(once_job.created_at_utc_ms, 1000, "restoration preserves creation time")

catchup: JobPolicies = JobPolicies(catch_up_misfires(Duration(90000), 4, 8), queue_one_overlap(), no_retry())
cron_record: StoredJobDefinition = codec_definition("cron-utc", encode_cron_utc("*/15 * * * *"), encode_policies(catchup))
cron_job: Job = restore_utc_job(cron_record, handlers)
cron_next: UtcInstant | None = cron_job.next_utc_after(UtcInstant(0))
nox.test.assert_true(cron_next is not None, "restored cron has a next fire")
if cron_next is not None:
    nox.test.assert_eq_int(cron_next.epoch_ms, 900000, "restored cron evaluates in UTC")
nox.test.assert_eq_str(encode_policies(cron_job.policy_config()), encode_policies(catchup), "catch-up and overlap policies round trip")

retrying: JobPolicies = JobPolicies(fire_once_misfires(Duration(25)), forbid_overlap(), exponential_retry(Duration(10), Duration(100), 4))
retry_job: Job = restore_utc_job(codec_definition("once-utc", "2000", encode_policies(retrying)), handlers)
nox.test.assert_eq_str(encode_policies(retry_job.policy_config()), encode_policies(retrying), "retry policy round trips")
nox.test.assert_eq_int(observed.calls, 1, "restoration never calls the bound handler")
nox.test.assert_true(rejects_codec_record(codec_definition("delay", "1000", defaults_encoded), handlers, "unsupported stored trigger kind"), "process-local triggers fail closed")
nox.test.assert_true(rejects_codec_record(codec_definition("once-utc", "9223372036854775808", defaults_encoded), handlers, "invalid stored nonnegative integer"), "integer overflow is rejected")
nox.test.assert_true(rejects_codec_record(codec_definition("once-utc", "01", defaults_encoded), handlers, "invalid stored nonnegative integer"), "noncanonical integer is rejected")
nox.test.assert_true(rejects_codec_record(codec_definition("cron-utc", "sensitive-token * * * *", defaults_encoded), handlers, "invalid stored UTC cron expression"), "malformed cron is rejected with a fixed message")
nox.test.assert_true(rejects_codec_record(codec_definition("once-utc", "2000", "default"), handlers, "invalid stored policy field count"), "opaque legacy policy is not interpreted")
nox.test.assert_true(rejects_codec_record(codec_definition("once-utc", "2000", "fire-once|25|0|0|queue-one|fixed|2|10|10"), handlers, "invalid stored job policy"), "unsupported policy combination is rejected")

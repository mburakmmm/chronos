from chronos.clock import FakeClock
from chronos.job import Job, JobContext, JobMetadata, make_utc_job
from chronos.scheduler import Scheduler
from chronos.time import UtcInstant
from chronos.trigger import OnceTrigger

def send_report(context: JobContext) -> None:
    print("run", context.job_id, context.attempt)

source_clock: FakeClock = FakeClock(1000, 0)
engine: Scheduler = Scheduler(source_clock, 100)
report: Job = make_utc_job("report.daily", "Daily report", OnceTrigger(UtcInstant(2000)), send_report, True, UtcInstant(1000), [JobMetadata("owner", "finance")])
engine.add(report)

jobs: list[Job] = engine.list_jobs()
print(len(jobs), jobs[0].name)
engine.disable("report.daily")
print(engine.list_jobs()[0].enabled)

import nox.os
from clock import FakeClock
from handler_registry import HandlerRegistry
from job import JobContext
from job_codec import encode_once_utc, encode_policies
from persistent_scheduler import PersistentScheduler
from policy import default_job_policies
from sqlite_store import SQLiteJobStore, open_sqlite_store
from store import make_stored_job_definition
from time import UtcInstant

def report(context: JobContext, account: str) -> None:
    if account != "reporting":
        raise ValueError("unknown reporting account")
    token: str = nox.os.getenv("CHRONOS_EXAMPLE_REPORT_TOKEN")
    if token == "":
        raise ValueError("missing reporting credential")
# In an application, pass token to the trusted report client here.

backend: SQLiteJobStore = open_sqlite_store(nox.os.arg(1))
try:
    handlers: HandlerRegistry = HandlerRegistry()
    handlers.register("report", report)
    now: UtcInstant = UtcInstant(1000)
    backend.put(make_stored_job_definition("report.once", "Report", "report", "reporting", "once-utc", encode_once_utc(now), encode_policies(default_job_policies()), True, now, now, 1), 0)
    engine: PersistentScheduler = PersistentScheduler(backend, handlers, FakeClock(1000, 0), 1)
    engine.watch("report.once")
    engine.start()
    for result in engine.tick():
        if result.committed_revision > 0:
            backend.record_outcome(result.job_id, result.committed_revision, result.status)
        print(result.status)
    engine.stop()
finally:
    backend.close()

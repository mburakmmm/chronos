import nox.fs
import nox.os
import nox.test
from chronos.clock import FakeClock
from chronos.errors import InvalidStoredJobError
from chronos.handler_registry import HandlerRegistry
from chronos.job import JobContext
from chronos.job_codec import encode_once_utc, encode_policies
from chronos.persistent_scheduler import PersistentScheduler
from chronos.policy import JobPolicies, default_job_policies, forbid_overlap, no_retry, skip_misfires
from chronos.sqlite_store import SQLiteJobStore, open_sqlite_store
from chronos.store import JobStore, StoredJobDefinition, make_stored_job_definition
from chronos.stored_cron import STORED_CRON_KIND, dispatch_stored_cron, encode_stored_cron
from chronos.stored_once import dispatch_stored_once
from chronos.stored_zoned_cron import ZONED_CRON_KIND, encode_zoned_cron
from chronos.time import Duration, UtcInstant
from examples.persistence.iana_rules import IanaZoneProvider

class InterruptedStore:
    backend: SQLiteJobStore
    mode: str

    def __init__(self, backend: SQLiteJobStore, mode: str) -> None:
        self.backend = backend
        self.mode = mode

    def load(self, job_id: str) -> StoredJobDefinition | None:

        return self.backend.load(job_id)

    def load_all(self) -> list[StoredJobDefinition]:

        return self.backend.load_all()

    def put(self, definition: StoredJobDefinition, expected_revision: int) -> None:

        if self.mode == "before-write":
            nox.os.exit(71)
        if self.mode == "before-commit":
            self.backend.connection.execute("BEGIN IMMEDIATE")
            self.backend.put(definition, expected_revision)
            nox.os.exit(74)
        self.backend.put(definition, expected_revision)
        if self.mode == "after-commit":
            nox.os.exit(72)

    def delete(self, job_id: str, expected_revision: int) -> None:

        self.backend.delete(job_id, expected_revision)

    def close(self) -> None:

        self.backend.close()

def make_handler(path: str, mode: str) -> (JobContext, str) -> None:
    def handle(context: JobContext, config: str) -> None:
        nox.fs.append_string(path, context.job_id + ":" + str(context.scheduled_time_ms) + ":" + str(context.attempt) + ":" + config + "\n")
        if mode == "after-effect":
            nox.os.exit(73)
        if mode == "handler-error":
            raise ValueError("private handler message")

    return handle

database_path: str = nox.os.arg(1)
effect_path: str = nox.os.arg(2)
mode: str = nox.os.arg(3)
recurring: bool = nox.os.arg_count() > 5 and nox.os.arg(5) == "cron"
zoned: bool = nox.os.arg_count() > 5 and nox.os.arg(5) == "zoned"
sqlite: SQLiteJobStore = open_sqlite_store(database_path)
backend: JobStore = InterruptedStore(sqlite, mode)
try:
    if mode == "init" or mode == "init-skip" or mode == "init-invalid":
        policies: JobPolicies = default_job_policies()
        if mode == "init-skip":
            policies = JobPolicies(skip_misfires(Duration(500)), forbid_overlap(), no_retry())
        kind: str = "once-utc"
        trigger_config: str = encode_once_utc(UtcInstant(1000))
        if recurring:
            kind = STORED_CRON_KIND
            trigger_config = encode_stored_cron("* * * * *", UtcInstant(1000))
            if mode == "init-invalid":
                trigger_config = "60001|* * * * *"
        if zoned:
            kind = ZONED_CRON_KIND
            trigger_config = encode_zoned_cron(IanaZoneProvider(), "2026f", "Europe/Berlin", "30 2 * * *", "both", "skip", UtcInstant(1729989000000))
        backend.put(make_stored_job_definition("fixture", "Restart fixture", "example", "public", kind, trigger_config, encode_policies(policies), True, UtcInstant(100), UtcInstant(200), 1), 0)
    else:
        handlers: HandlerRegistry = HandlerRegistry()
        handlers.register("example", make_handler(effect_path, mode))
        now: UtcInstant = UtcInstant(int(nox.os.arg(4)))
        result: str = ""
        if recurring:
            try:
                result = dispatch_stored_cron(backend, handlers, "fixture", now)
            except InvalidStoredJobError as error:
                if mode != "invalid":
                    raise error
                result = error.message
        elif zoned:
            engine: PersistentScheduler = PersistentScheduler(backend, handlers, FakeClock(now.epoch_ms, 0), 1, IanaZoneProvider())
            engine.watch("fixture")
            engine.start()
            result = engine.tick()[0].status
            engine.stop()
        else:
            result = dispatch_stored_once(backend, handlers, "fixture", now)
        record: StoredJobDefinition | None = backend.load("fixture")
        nox.test.assert_true(record is not None, "consumption retains the definition")
        if record is not None:
            if recurring:
                print(result, record.revision, record.enabled, record.updated_at_utc_ms, record.trigger_config)
            else:
                print(result, record.revision, record.enabled, record.updated_at_utc_ms)
finally:
    backend.close()

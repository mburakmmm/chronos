import nox.test
from errors import TimeRangeError
from proofs.timezone.civil import LocalDateTime, ZoneProvider, resolve_civil
from proofs.timezone.fixture import FixtureZoneProvider, fixture_rules
from proofs.timezone.model import LocalWallTime, ZonePrototypeError, ZoneRules, ZoneTransition, select_occurrences
from time import UtcInstant

def verify(zone_rules: ZoneRules, wall_ms: int, expected: list[int]) -> None:
    candidates: list[UtcInstant] = zone_rules.resolve(LocalWallTime(wall_ms))
    nox.test.assert_eq_int(len(candidates), len(expected), "candidate count")
    for index in range(len(expected)):
        nox.test.assert_eq_int(candidates[index].epoch_ms, expected[index], "ordered UTC candidate")

def rejects_bad_zone() -> bool:
    try:
        fixture_rules("Unknown/Zone")
    except ZonePrototypeError:
        return True
    return False

def rejects_outside(zone_rules: ZoneRules) -> bool:
    try:
        zone_rules.resolve(LocalWallTime(1704067200000))
    except TimeRangeError:
        return True
    return False

def rejects_unordered_rules() -> bool:
    try:
        ZoneRules(0, 345600000, 0, [ZoneTransition(200000000, 2000), ZoneTransition(100000000, 1000)])
    except ZonePrototypeError:
        return True
    return False

berlin: ZoneRules = fixture_rules("Europe/Berlin")
verify(berlin, 1711850399999, [1711846799999])
verify(berlin, 1711850400000, [])
verify(berlin, 1711853999999, [])
verify(berlin, 1711854000000, [1711846800000])
verify(berlin, 1729994399999, [1729987199999])
verify(berlin, 1729994400000, [1729987200000, 1729990800000])
verify(berlin, 1729997999999, [1729990799999, 1729994399999])
verify(berlin, 1729998000000, [1729994400000])
folded: list[UtcInstant] = berlin.resolve(LocalWallTime(1729994400000))
nox.test.assert_eq_int(select_occurrences(folded, "first")[0].epoch_ms, 1729987200000, "first fold occurrence")
nox.test.assert_eq_int(select_occurrences(folded, "last")[0].epoch_ms, 1729990800000, "last fold occurrence")
nox.test.assert_eq_int(len(select_occurrences(folded, "both")), 2, "both fold occurrences")
nox.test.assert_eq_int(len(select_occurrences(folded, "neither")), 0, "neither fold occurrence")
nox.test.assert_eq_int(len(select_occurrences(berlin.resolve(LocalWallTime(1711850400000)), "first")), 0, "gap remains empty")

lord_howe: ZoneRules = fixture_rules("Australia/Lord_Howe")
verify(lord_howe, 1712453400000, [1712413800000, 1712415600000])
verify(lord_howe, 1712455200000, [1712417400000])
verify(lord_howe, 1728180000000, [])
verify(lord_howe, 1728181800000, [1728142200000])

kathmandu: ZoneRules = fixture_rules("Asia/Kathmandu")
verify(kathmandu, 504921599999, [504901799999])
verify(kathmandu, 504921600000, [])
verify(kathmandu, 504922500000, [504901800000])
second_offset: ZoneRules = ZoneRules(0, 345600000, 45, [])
verify(second_offset, 172845000, [172800000])

nox.test.assert_true(rejects_bad_zone(), "unknown zones are rejected")
nox.test.assert_true(rejects_outside(berlin), "incomplete boundary coverage is rejected")
nox.test.assert_true(rejects_unordered_rules(), "unordered tables are rejected")

def rejects_civil(year: int, month: int, day: int, hour: int, minute: int, second: int, ms: int) -> bool:
    try:
        LocalDateTime(year, month, day, hour, minute, second, ms)
    except ZonePrototypeError:
        return True
    return False

def rejects_provider_request(provider: ZoneProvider, version: str, zone_name: str, expected: str) -> bool:
    try:
        resolve_civil(provider, version, zone_name, LocalDateTime(2024, 10, 27, 2, 0, 0, 0))
    except ZonePrototypeError as error:
        return error.message == expected
    return False

provider: ZoneProvider = FixtureZoneProvider()
nox.test.assert_eq_str(provider.version(), "2026f", "fixture advertises the pinned ruleset")
calendar_fold: list[UtcInstant] = resolve_civil(provider, "2026f", "Europe/Berlin", LocalDateTime(2024, 10, 27, 2, 59, 59, 999))
nox.test.assert_eq_int(len(calendar_fold), 2, "fold survives civil conversion")
nox.test.assert_eq_int(calendar_fold[0].epoch_ms, 1729990799999, "first fold preserves milliseconds")
nox.test.assert_eq_int(calendar_fold[1].epoch_ms, 1729994399999, "second fold preserves milliseconds")
nox.test.assert_eq_int(len(resolve_civil(provider, "2026f", "Europe/Berlin", LocalDateTime(2024, 3, 31, 2, 0, 0, 0))), 0, "civil gap yields no candidate")
ordinary: list[UtcInstant] = resolve_civil(provider, "2026f", "Asia/Kathmandu", LocalDateTime(1986, 1, 1, 0, 15, 0, 12))
nox.test.assert_eq_int(len(ordinary), 1, "ordinary civil result is unambiguous")
nox.test.assert_eq_int(ordinary[0].epoch_ms, 504901800012, "historical offset preserves milliseconds")
nox.test.assert_eq_int(LocalDateTime(2000, 2, 29, 0, 0, 0, 9).to_wall_time().wall_ms, 951782400009, "century leap rule")
nox.test.assert_eq_int(LocalDateTime(9999, 12, 31, 23, 59, 59, 999).to_wall_time().wall_ms, 253402300799999, "civil construction upper bound")
nox.test.assert_true(rejects_civil(2100, 2, 29, 0, 0, 0, 0), "century non-leap rule")
nox.test.assert_true(rejects_civil(2024, 4, 31, 0, 0, 0, 0), "month-specific day bounds")
nox.test.assert_true(rejects_civil(2024, 13, 1, 0, 0, 0, 0), "month must be in range")
nox.test.assert_true(rejects_civil(1969, 12, 31, 23, 59, 59, 999), "pre-epoch civil year rejected")
nox.test.assert_true(rejects_civil(2024, 1, 1, 24, 0, 0, 0), "24:00 rejected")
nox.test.assert_true(rejects_civil(2024, 1, 1, 0, 0, 60, 0), "leap second rejected")
nox.test.assert_true(rejects_civil(2024, 1, 1, 0, 0, 0, 1000), "milliseconds must be in range")
nox.test.assert_true(rejects_provider_request(provider, "2026e", "Europe/Berlin", "timezone ruleset version mismatch"), "different ruleset rejected")
nox.test.assert_true(rejects_provider_request(provider, "", "Europe/Berlin", "timezone ruleset version mismatch"), "explicit ruleset required")
nox.test.assert_true(rejects_provider_request(provider, "2026f", "Europe/Unknown", "unknown timezone fixture"), "unknown zone fails closed")
print("timezone-prototype-ok")

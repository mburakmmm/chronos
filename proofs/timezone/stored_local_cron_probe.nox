import nox.fs
import nox.os
import nox.test
from chronos.clock import FakeClock
from chronos.errors import InvalidStoredJobError, StoreConflictError, TimeRangeError
from chronos.handler_registry import HandlerRegistry
from chronos.job import JobContext
from chronos.job_codec import encode_policies
from chronos.persistent_scheduler import PersistentScheduler
from chronos.policy import JobPolicies, default_job_policies, forbid_overlap, no_retry, skip_misfires
from chronos.timezone_civil import ZoneProvider
from proofs.timezone.fixture import FixtureZoneProvider
from chronos.timezone import TimezoneError, ZoneRules
from chronos.stored_zoned_cron import ZONED_CRON_KIND, ZonedCronConfig, dispatch_zoned_cron, encode_zoned_cron, migrate_zoned_cron, validate_zoned_cron
from chronos.sqlite_store import SQLiteJobStore, open_sqlite_store
from chronos.store import JobStore, StoredJobDefinition, make_stored_job_definition
from chronos.time import Duration, UtcInstant
from examples.persistence.iana_rules import IanaZoneProvider

class ShiftedBerlinProvider:
    offset_seconds: int
    version_name: str

    def __init__(self, offset_seconds: int, version_name: str) -> None:
        self.offset_seconds = offset_seconds
        self.version_name = version_name

    def version(self) -> str:

        return self.version_name

    def rules_for(self, zone_name: str) -> ZoneRules:

        if zone_name != "Europe/Berlin":
            raise TimezoneError("unknown synthetic timezone")
        return ZoneRules(1704067200000, 1767225600000, self.offset_seconds, [])

def read(backend: JobStore, job_id: str) -> StoredJobDefinition:
    definition: StoredJobDefinition | None = backend.load(job_id)
    if definition is None:
        raise ValueError("missing test definition")
    return definition

def rejects_wrong_version(definition: StoredJobDefinition, provider: ZoneProvider) -> bool:
    try:
        validate_zoned_cron(definition, provider)
    except TimezoneError as error:
        return error.message == "timezone ruleset version mismatch"
    return False

def rejects_outside_coverage(backend: JobStore, original: ZoneProvider, shifted: ZoneProvider) -> bool:
    try:
        migrate_zoned_cron(backend, original, shifted, "synthetic-review-1", "future", 1, UtcInstant(1767312000000))
    except TimeRangeError:
        return True
    return False

def rejects_stale(backend: JobStore, original: ZoneProvider, shifted: ZoneProvider) -> bool:
    try:
        migrate_zoned_cron(backend, original, shifted, "synthetic-review-1", "future", 1, UtcInstant(1719813600000))
    except StoreConflictError as error:
        return error.expected_revision == 1 and error.actual_revision == 2
    return False

def rejects_resume_rewind(backend: JobStore, original: ZoneProvider, extended: ZoneProvider) -> bool:
    try:
        migrate_zoned_cron(backend, original, extended, "2026f", "fold", 4, UtcInstant(1767225599999))
    except InvalidStoredJobError:
        return True
    return False

original: ZoneProvider = FixtureZoneProvider()
shifted: ZoneProvider = ShiftedBerlinProvider(3600, "synthetic-review-1")
earlier: ZoneProvider = ShiftedBerlinProvider(10800, "synthetic-review-2")
path: str = nox.os.getenv("CHRONOS_SQLITE_TEST_DB")
backend: SQLiteJobStore = open_sqlite_store(path)
start: UtcInstant = UtcInstant(1719813600000)
payload: str = encode_zoned_cron(original, "2026f", "Europe/Berlin", "0 9 * * *", "first", "skip", start)
for key in ["future", "cutoff", "no-rewind"]:
    backend.put(make_stored_job_definition(key, "Report", "report", "public", ZONED_CRON_KIND, payload, encode_policies(default_job_policies()), False, start, start, 1), 0)
backend.close()

reopened: SQLiteJobStore = open_sqlite_store(path)
original_record: StoredJobDefinition = read(reopened, "future")
nox.test.assert_eq_int(validate_zoned_cron(original_record, original).cursor.epoch_ms, 1719817200000, "old pending cursor remains pinned")
nox.test.assert_true(rejects_wrong_version(original_record, shifted), "different provider cannot reinterpret a record")
nox.test.assert_true(rejects_outside_coverage(reopened, original, shifted), "failed migration rejects target outside coverage")
nox.test.assert_eq_str(read(reopened, "future").trigger_config, payload, "failed migration preserves cursor")
nox.test.assert_eq_int(read(reopened, "future").revision, 1, "failed migration preserves revision")
migrate_zoned_cron(reopened, original, shifted, "synthetic-review-1", "future", 1, start)
migrate_zoned_cron(reopened, original, shifted, "synthetic-review-1", "cutoff", 1, UtcInstant(1719820800000))
migrate_zoned_cron(reopened, original, earlier, "synthetic-review-2", "no-rewind", 1, UtcInstant(1719813599999))
nox.test.assert_true(rejects_stale(reopened, original, shifted), "stale migration cannot overwrite a new revision")
reopened.close()

updated: SQLiteJobStore = open_sqlite_store(path)
record: StoredJobDefinition = read(updated, "future")
migrated: ZonedCronConfig = validate_zoned_cron(record, shifted)
nox.test.assert_eq_int(record.revision, 2, "migration commits one revision")
nox.test.assert_true(not record.enabled, "migration preserves disabled state")
nox.test.assert_eq_str(record.policy_config, original_record.policy_config, "migration preserves dispatch policies")
nox.test.assert_eq_str(record.handler_key, original_record.handler_key, "migration preserves handler identity")
nox.test.assert_eq_str(migrated.version, "synthetic-review-1", "new version survives process-style reopen")
nox.test.assert_eq_str(migrated.fold, "first", "fold rule stays pinned")
nox.test.assert_eq_int(migrated.cursor.epoch_ms, 1719820800000, "new rules determine the next UTC candidate")
nox.test.assert_eq_int(validate_zoned_cron(read(updated, "cutoff"), shifted).cursor.epoch_ms, 1719907200000, "exact cutoff is not replayed")
nox.test.assert_eq_int(validate_zoned_cron(read(updated, "no-rewind"), earlier).cursor.epoch_ms, 1719900000000, "earlier revised match cannot move the pending cursor backward")
nox.test.assert_true(rejects_wrong_version(record, original), "the old provider cannot resume the migrated record")

def verify_dispatch(backend: JobStore, provider: ZoneProvider) -> HandlerRegistry:
    handlers: HandlerRegistry = HandlerRegistry()
    called: list[int] = []
    def record_delivery(context: JobContext, config: str) -> None:
        nox.test.assert_eq_str(config, "public", "handler receives registered configuration")
        called.append(context.scheduled_time_ms)
    handlers.register("report", record_delivery)
    first: UtcInstant = UtcInstant(1729989000000)
    encoded: str = encode_zoned_cron(provider, "2026f", "Europe/Berlin", "30 2 * * *", "both", "skip", first)
    policies: JobPolicies = JobPolicies(skip_misfires(Duration(0)), forbid_overlap(), no_retry())
    backend.put(make_stored_job_definition("fold", "Report", "report", "public", ZONED_CRON_KIND, encoded, encode_policies(policies), True, first, first, 1), 0)
    nox.test.assert_eq_str(dispatch_zoned_cron(backend, handlers, provider, "fold", UtcInstant(first.epoch_ms - 1)), "pending", "future fold stays pending")
    nox.test.assert_eq_str(dispatch_zoned_cron(backend, handlers, provider, "fold", first), "succeeded", "first fold fires")
    nox.test.assert_eq_int(len(called), 1, "one handler invocation")
    nox.test.assert_eq_int(called[0], first.epoch_ms, "callback receives planned UTC time")
    nox.test.assert_eq_int(validate_zoned_cron(read(backend, "fold"), provider).cursor.epoch_ms, 1729992600000, "second fold is committed")
    return handlers

handlers: HandlerRegistry = verify_dispatch(updated, original)
updated.close()
dispatch_store: SQLiteJobStore = open_sqlite_store(path)
nox.test.assert_eq_str(dispatch_zoned_cron(dispatch_store, handlers, original, "fold", UtcInstant(1729989000000)), "pending", "reopen cannot replay first fold")
nox.test.assert_eq_str(dispatch_zoned_cron(dispatch_store, handlers, original, "fold", UtcInstant(1729992600000)), "succeeded", "reopen dispatches second fold")
nox.test.assert_eq_str(dispatch_zoned_cron(dispatch_store, handlers, original, "fold", UtcInstant(1767225600000)), "skipped", "overdue cursor is skipped at coverage end")
nox.test.assert_true(not read(dispatch_store, "fold").enabled, "coverage end disables the record")
dispatch_store.close()
terminal: SQLiteJobStore = open_sqlite_store(path)
nox.test.assert_eq_str(dispatch_zoned_cron(terminal, handlers, original, "fold", UtcInstant(1729992600000)), "exhausted", "terminal record survives reopen and clock rewind")
nox.test.assert_eq_int(read(terminal, "fold").revision, 4, "terminal read does not change revision")
extended: ZoneProvider = IanaZoneProvider()
nox.test.assert_true(rejects_resume_rewind(terminal, original, extended), "terminal resume cannot rewind observed time")
nox.test.assert_eq_int(read(terminal, "fold").revision, 4, "invalid resume leaves the row untouched")
migrate_zoned_cron(terminal, original, extended, "2026f", "fold", 4, UtcInstant(1767225600000))
nox.test.assert_true(read(terminal, "fold").enabled, "operator explicitly resumes the exhausted record")
nox.test.assert_eq_int(validate_zoned_cron(read(terminal, "fold"), extended).cursor.epoch_ms, 1767231000000, "extended coverage starts strictly after cutoff")
terminal.close()

resumed: SQLiteJobStore = open_sqlite_store(path)
clock: FakeClock = FakeClock(1767231000000, 0)
no_rules: PersistentScheduler = PersistentScheduler(resumed, handlers, clock, 1)
no_rules.watch("fold")
no_rules.start()
nox.test.assert_eq_str(no_rules.tick()[0].status, "timezone-unavailable", "old constructor requires opt-in for zoned records")
wrong_rules: PersistentScheduler = PersistentScheduler(resumed, handlers, clock, 1, shifted)
wrong_rules.watch("fold")
wrong_rules.start()
nox.test.assert_eq_str(wrong_rules.tick()[0].status, "schedule-error", "mismatched rules cannot reinterpret a pending occurrence")
nox.test.assert_eq_int(read(resumed, "fold").revision, 5, "missing or mismatched provider cannot consume a cursor")
engine: PersistentScheduler = PersistentScheduler(resumed, handlers, clock, 1, extended)
engine.watch("fold")
engine.start()
nox.test.assert_eq_int(engine.tick()[0].committed_revision, 6, "public scheduler commits the resumed occurrence")
clock.set_utc_ms(1729989000000)
nox.test.assert_eq_str(engine.tick()[0].status, "pending", "resumed record cannot replay an old fold")
resumed.close()
nox.fs.remove_file(path)
print("zoned-cron-storage-ok")
